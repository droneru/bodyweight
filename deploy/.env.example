# Production settings of the app. Copy to deploy/.env on the VPS and fill in.
# deploy/.env and deploy/secrets/ are not committed.

# Serverless YDB: see the "Connection" section of the database page in Yandex Cloud.
# The authorized key of the sa goes to deploy/secrets/sa-key.json.
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/b1gxxxxxxxxxxxxxxxxx/etnxxxxxxxxxxxxxxxxx
YDB_SERVICE_ACCOUNT_KEY_FILE_CREDENTIALS=/run/secrets/sa-key.json

# Or a YDB container named bodyweight-ydb on the "proxy" docker network, without authentication:
# YDB_ENDPOINT=grpc://bodyweight-ydb:2136
# YDB_DATABASE=/local
# YDB_ANONYMOUS_CREDENTIALS=1

# Yandex OAuth application, https://oauth.yandex.ru. Its Redirect URI must be
# https://bodyweight.ru/api/auth/yandex/callback
BODYWEIGHT_YANDEX_CLIENT_ID=
BODYWEIGHT_YANDEX_CLIENT_SECRET=
